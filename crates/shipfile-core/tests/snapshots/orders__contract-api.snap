---
source: crates/shipfile-core/tests/orders.rs
expression: "model.contract(service).expect(\"known service\")"
---
{
  "service": "api",
  "vars": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "local": {
        "from": "literal",
        "value": "local"
      },
      "aws": {
        "from": "unset"
      },
      "secret": false
    },
    {
      "name": "AWS_ENDPOINT_URL_SQS",
      "local": {
        "from": "literal",
        "value": "http://elasticmq:9324"
      },
      "aws": {
        "from": "unset"
      },
      "secret": false
    },
    {
      "name": "AWS_REGION",
      "local": {
        "from": "literal",
        "value": "ap-south-1"
      },
      "aws": {
        "from": "region"
      },
      "secret": false
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "local": {
        "from": "literal",
        "value": "local"
      },
      "aws": {
        "from": "unset"
      },
      "secret": false
    },
    {
      "name": "LOG_LEVEL",
      "local": {
        "from": "literal",
        "value": "info"
      },
      "aws": {
        "from": "literal",
        "value": "info"
      },
      "secret": false
    },
    {
      "name": "MAIN_DB_HOST",
      "local": {
        "from": "literal",
        "value": "postgres"
      },
      "aws": {
        "from": "db_address",
        "database": "main-db"
      },
      "secret": false
    },
    {
      "name": "MAIN_DB_NAME",
      "local": {
        "from": "literal",
        "value": "main_db"
      },
      "aws": {
        "from": "literal",
        "value": "main_db"
      },
      "secret": false
    },
    {
      "name": "MAIN_DB_PASSWORD",
      "local": {
        "from": "literal",
        "value": "shipfile"
      },
      "aws": {
        "from": "db_secret",
        "database": "main-db",
        "field": "password"
      },
      "secret": true
    },
    {
      "name": "MAIN_DB_PORT",
      "local": {
        "from": "literal",
        "value": "5432"
      },
      "aws": {
        "from": "db_port",
        "database": "main-db"
      },
      "secret": false
    },
    {
      "name": "MAIN_DB_USER",
      "local": {
        "from": "literal",
        "value": "shipfile"
      },
      "aws": {
        "from": "db_secret",
        "database": "main-db",
        "field": "username"
      },
      "secret": false
    },
    {
      "name": "ORDERS_QUEUE_URL",
      "local": {
        "from": "literal",
        "value": "http://elasticmq:9324/000000000000/orders-queue"
      },
      "aws": {
        "from": "queue_url",
        "queue": "orders-queue"
      },
      "secret": false
    },
    {
      "name": "STRIPE_KEY",
      "local": {
        "from": "dot_env",
        "key": "STRIPE_KEY"
      },
      "aws": {
        "from": "ssm_parameter",
        "key": "STRIPE_KEY"
      },
      "secret": true
    }
  ],
  "grants": [
    {
      "role": "task",
      "target": "queues.orders-queue",
      "actions": [
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:SendMessage"
      ]
    },
    {
      "role": "execution",
      "target": "databases.main-db.secret",
      "actions": [
        "secretsmanager:GetSecretValue"
      ]
    },
    {
      "role": "execution",
      "target": "secrets.STRIPE_KEY",
      "actions": [
        "ssm:GetParameters"
      ]
    }
  ],
  "network": [
    "main-db"
  ]
}
